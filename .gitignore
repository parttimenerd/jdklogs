# Build output
target/
generator/target/
site/node_modules/
site/dist/
# tsc byproducts — the served bundle is Vite → dist/, TS is the source of truth
site/src/*.js
site/test/*.js

# Test artifacts
site/test-results/
site/playwright-report/
site/.playwright-mcp/

# Local JDK checkouts used only for generation
.jdk-src/
*.gclog
*.gclog.gz

# Generated site data — produced monthly by regen-data.yml and shuttled between the
# regen and build workflows via actions/cache, NOT committed. Hand-curated JSON
# (jfr-mappings/coverage/proposed-events) stays tracked.
data/head.json
data/head.*.log
data/tags.json

# Transient capture/harness scratch dirs
harness-*/
capture/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
